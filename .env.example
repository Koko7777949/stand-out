# ============================================================
# Stand Out — متغيرات البيئة (انسخ الملف لـ .env وعدّل القيم)
# cp .env.example .env
# كل القيم تبقى على السيرفر — لا ترفع .env إلى Git أبدًا
# ملاحظة: معظم المفاتيح يمكن ضبطها أيضًا من لوحة الأدمن
# (تاب الإعدادات) بدون إعادة نشر — وقيم اللوحة تتقدم على البيئة
# ============================================================

# ---- قاعدة البيانات (إلزامي) ----
# تطوير: SQLite | إنتاج: Postgres (postgres://user:pass@host:5432/db)
DATABASE_URL="file:./db/custom.db"

# ---- المفاتيح السرية (إلزامي في الإنتاج — ولّد قيمًا عشوائية 64 حرفًا) ----
# مفتاح تجزئة الجلسات وتوقيع تذاكر الأدمن و hash الـ IP
SESSION_SECRET=""
# توقيع توكنات QR وتوقيع ويبهوك مزود الدفع (لو فاضي بيستخدم قيمة داخلية — غيّرها في الإنتاج)
QR_SIGNING_SECRET=""

# ---- أرقام المسؤولين (اختياري) ----
# مفصولة بفواصل — بتترفع تلقائيًا super_admin عند أول تشغيل
# الافتراضي بدون المتغير: 01200506224,01107548985
ADMIN_PHONES=""

# ---- الإيميل: Resend (لأكواد التحقق بالإيميل) ----
RESEND_API_KEY=""
# بعد تفعيل دومينك في Resend:
# EMAIL_FROM="Stand Out <no-reply@yourdomain.com>"
EMAIL_FROM=""

# ---- واتساب: اختار مزود واحد وظبط مفاتيحه ----
# المزود يُختار من لوحة الأدمن (ultramsg | meta | greenapi | twilio | custom)
# وهنا مفاتيح البيئة كبديل — قيم اللوحة تتقدم على البيئة

# UltraMsg (الأسهل لمصر): من حسابك على ultramsg.com
ULTRAMSG_INSTANCE=""
ULTRAMSG_TOKEN=""

# Meta WhatsApp Cloud API (الرسمي): developers.facebook.com
META_WHATSAPP_TOKEN=""
META_PHONE_NUMBER_ID=""
# اختياري: اسم Template معتمد بمتغير {{1}} للكود + لغته (نص حر لو فاضي)
META_WHATSAPP_TEMPLATE_NAME=""
META_WHATSAPP_TEMPLATE_LANG="ar"

# Green API: green-api.com
GREEN_API_INSTANCE=""
GREEN_API_TOKEN=""

# Twilio WhatsApp: console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ---- SMS الاحتياطي (لو واتساب فشل): SMSMisr ----
SMSMISR_USERNAME=""
SMSMISR_PASSWORD=""
SMSMISR_TOKEN=""
